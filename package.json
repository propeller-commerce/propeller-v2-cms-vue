{
  "name": "@propeller-commerce/propeller-v2-cms-vue",
  "version": "0.1.3",
  "description": "CMS page renderer + block dispatcher + adapter provider for Propeller Commerce Vue shops. Pairs with any propeller-v2-cms-adapter-* package.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue\""
  },
  "peerDependencies": {
    "@propeller-commerce/propeller-v2-core-ui": ">=0.2.4 <0.4",
    "vue": ">=3.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "@propeller-commerce/propeller-sdk-v2": "^0.13.0",
    "@propeller-commerce/propeller-v2-core-ui": "^0.3.1",
    "typescript": "~5.9",
    "vite": "^7",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "sideEffects": false
}
